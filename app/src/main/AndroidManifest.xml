<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice search in SearchActivity; runtime-requested on first mic use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Optional: voice search only; must not block install on mic-less TVs. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Sinema"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sinema"
        android:name=".SinemaApp"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.FolderBrowseActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.SceneDetailActivity"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Sinema.Details" />

        <activity
            android:name=".ui.PlaybackActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".ui.SearchActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.ImageViewActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.SettingsActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.FavoritesActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.BrowseFoldersActivity"
            android:screenOrientation="landscape" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.PinActivity"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Sinema" />

        <activity
            android:name=".ui.SetupActivity"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Sinema" />

        <activity
            android:name=".ui.EntityGridActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.EntityScenesActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.SavedFiltersActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.SavedFilterScenesActivity"
            android:screenOrientation="landscape" />

        <receiver
            android:name=".util.TvChannelInitReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="androidx.tvprovider.media.tv.INITIALIZE_PROGRAMS" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.DeepLinkActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.sinema" android:host="app" android:pathPrefix="/scene/" />
            </intent-filter>
        </activity>

        <!-- Global (system) search: opt-in only. Both components ship
             disabled; Settings → Global Search flips them on together.
             Suggestion clicks resolve via DeepLinkActivity above. -->
        <activity
            android:name=".ui.GlobalSearchActivity"
            android:enabled="false"
            android:exported="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <provider
            android:name=".util.GlobalSearchProvider"
            android:authorities="com.sinema.globalsearch"
            android:enabled="false"
            android:exported="true"
            android:readPermission="android.permission.GLOBAL_SEARCH" />

    </application>
</manifest>
