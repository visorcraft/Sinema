<?xml version="1.0" encoding="utf-8"?>
<!-- Wrapped in ScrollView: the full option set exceeds one dialog height on TV. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="Active filters (select to remove)"
            android:textAllCaps="true"
            android:textColor="@color/screens_polish_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/filter_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:focusable="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/filter_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/screens_polish_dialog_button_background"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Save as Stash filter…"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.08"
            android:text="Watched"
            android:textAllCaps="true"
            android:textColor="@color/screens_polish_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/filter_watch_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/filter_watch_all"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:text="All scenes"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_watch_watched"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Watched"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_watch_unwatched"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Unwatched"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/filter_favorites"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Favorites only"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/screens_polish_hairline"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="Minimum rating"
            android:textAllCaps="true"
            android:textColor="@color/screens_polish_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/filter_rating_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/filter_rating_0"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:text="Any rating"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_rating_1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="★ and up"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_rating_2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="★★ and up"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_rating_3"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="★★★ and up"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_rating_4"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="★★★★ and up"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_rating_5"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="★★★★★ only"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/screens_polish_hairline"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="Resolution"
            android:textAllCaps="true"
            android:textColor="@color/screens_polish_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/filter_resolution_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/filter_resolution_any"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:text="Any resolution"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_resolution_under_hd"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Under 720p"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_resolution_hd"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="720p or better"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_resolution_full_hd"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="1080p or better"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_resolution_four_k"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="4K or better"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/screens_polish_hairline"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="Markers"
            android:textAllCaps="true"
            android:textColor="@color/screens_polish_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/filter_markers_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/filter_markers_any"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:checked="true"
                android:text="Any"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_markers_with"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="24dp"
                android:text="With"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_markers_without"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="24dp"
                android:text="Without"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="Captions"
            android:textAllCaps="true"
            android:textColor="@color/screens_polish_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/filter_captions_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/filter_captions_any"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:checked="true"
                android:text="Any"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_captions_with"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="24dp"
                android:text="With"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/filter_captions_without"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="24dp"
                android:text="Without"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/screens_polish_hairline"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:text="Advanced"
            android:textAllCaps="true"
            android:textColor="@color/screens_polish_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/filter_duration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/screens_polish_dialog_button_background"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Duration: Any duration"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/filter_release_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/screens_polish_dialog_button_background"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Release date: Any release date"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/filter_codec"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/screens_polish_dialog_button_background"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Video codec: Any codec"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/filter_performers"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/screens_polish_dialog_button_background"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Performers: Any"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/filter_studios"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/screens_polish_dialog_button_background"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Studios: Any"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/filter_tags"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/screens_polish_dialog_button_background"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Tags: Any"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
