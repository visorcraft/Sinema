<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/up_next_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="2"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@android:color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/up_next_move_up"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:focusable="true"
        android:contentDescription="@string/accessibility_move_earlier"
        android:text="▲"
        android:textSize="14sp" />

    <Button
        android:id="@+id/up_next_move_down"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:focusable="true"
        android:contentDescription="@string/accessibility_move_later"
        android:text="▼"
        android:textSize="14sp" />

    <Button
        android:id="@+id/up_next_remove"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:focusable="true"
        android:contentDescription="@string/accessibility_remove_queue"
        android:text="✕"
        android:textSize="14sp" />
</LinearLayout>
