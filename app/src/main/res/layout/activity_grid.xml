<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B1B1B"
    android:orientation="vertical">

    <!-- Optional entity detail header: image + name + scene count + tag chips.
         Populated by EntityScenesActivity; every other grid screen leaves it gone. -->
    <LinearLayout
        android:id="@+id/entity_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="16dp"
        android:paddingEnd="48dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/entity_header_image"
            android:layout_width="128dp"
            android:layout_height="176dp"
            android:layout_marginEnd="24dp"
            android:background="#333333"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/entity_header_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/entity_header_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:id="@+id/entity_header_tags_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:focusable="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/entity_header_tags_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grid_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="12dp"
        android:paddingEnd="48dp"
        android:clipChildren="false">

        <Button
            android:id="@+id/btn_grid_filter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/action_button_background"
            android:focusable="true"
            android:minWidth="160dp"
            android:text="Filter"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_grid_sort"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/action_button_background"
            android:focusable="true"
            android:minWidth="120dp"
            android:text="Sort"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_grid_search"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/action_button_background"
            android:focusable="true"
            android:minWidth="140dp"
            android:text="Search"
            android:textColor="@android:color/white"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/main_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
