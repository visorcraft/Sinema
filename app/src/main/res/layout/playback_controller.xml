<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ContentDescription,PrivateResource">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/playback_polish_scrim" />

    <LinearLayout
        android:id="@+id/playback_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="20dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/playback_scene_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/playback_queue_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:background="@drawable/card_focus_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/playback_next_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:background="@drawable/card_focus_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/playback_next_thumb"
                android:layout_width="106dp"
                android:layout_height="60dp"
                android:background="#333333"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/playback_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playback_preview_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="174dp"
        android:background="@drawable/playback_polish_time_background"
        android:gravity="center_horizontal"
        android:minWidth="148dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playback_preview_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playback_preview_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/playback_polish_accent_bright"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/playback_preview_chapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxWidth="360dp"
            android:maxLines="1"
            android:textColor="@color/playback_polish_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/playback_preview_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/playback_polish_dwell_hint"
            android:textColor="@color/playback_polish_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/playback_seek_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="108dp"
        android:background="@drawable/playback_polish_feedback_background"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="420dp"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/playback_skip_marker"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_primary_button"
        android:focusable="true"
        android:minWidth="220dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#55000000"
        android:gravity="center"
        android:padding="12dp"
        android:clipToPadding="false"
        android:layoutDirection="ltr">

        <!-- Marker navigation must keep working with a single MediaItem and
             repeat off: Media3 disables its own exo_prev/exo_next buttons
             whenever COMMAND_SEEK_TO_PREVIOUS/NEXT is unavailable, so these
             use custom ids that PlayerControlView does not manage. -->
        <ImageButton
            android:id="@+id/playback_prev_marker_button"
            style="@style/ExoStyledControls.Button.Center.Previous"
            android:contentDescription="@string/playback_previous_marker" />

        <include layout="@layout/exo_player_control_rewind_button" />

        <ImageButton android:id="@id/exo_play_pause" style="@style/ExoStyledControls.Button.Center.PlayPause" />

        <include layout="@layout/exo_player_control_ffwd_button" />

        <ImageButton
            android:id="@+id/playback_next_marker_button"
            style="@style/ExoStyledControls.Button.Center.Next"
            android:contentDescription="@string/playback_next_marker" />
    </LinearLayout>

    <LinearLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="10dp"
        android:paddingEnd="48dp"
        android:paddingBottom="14dp"
        android:background="#C0000000"
        android:layoutDirection="ltr">

        <LinearLayout
            android:id="@id/exo_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:importantForAccessibility="noHideDescendants">

            <TextView
                android:id="@id/exo_position"
                style="@style/ExoStyledControls.TimeText.Position"
                android:textSize="22sp" />

            <TextView style="@style/ExoStyledControls.TimeText.Separator" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/ExoStyledControls.TimeText.Duration"
                android:textSize="22sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/playback_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <com.sinema.ui.MarkerTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:bar_height="@dimen/playback_polish_timebar_height"
            app:buffered_color="@color/playback_polish_track_buffered"
            app:played_color="@color/playback_polish_accent"
            app:scrubber_color="@color/playback_polish_accent_bright"
            app:scrubber_dragged_size="@dimen/playback_polish_scrubber_dragged_size"
            app:scrubber_enabled_size="@dimen/playback_polish_scrubber_enabled_size"
            app:unplayed_color="@color/playback_polish_track_unplayed" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false">

            <LinearLayout
                android:id="@id/exo_basic_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="ltr">

                <ImageButton android:id="@id/exo_repeat_toggle" style="@style/ExoStyledControls.Button.Bottom.RepeatToggle" />
                <ImageButton android:id="@id/exo_subtitle" style="@style/ExoStyledControls.Button.Bottom.CC" />
                <ImageButton
                    android:id="@+id/playback_folder_button"
                    style="@style/ExoStyledControls.Button.Bottom"
                    android:contentDescription="@string/playback_open_folder"
                    android:enabled="false"
                    android:src="@drawable/ic_folder" />
                <ImageButton
                    android:id="@+id/playback_personalization_button"
                    style="@style/ExoStyledControls.Button.Bottom"
                    android:contentDescription="@string/playback_personalization"
                    android:src="@drawable/ic_person" />
                <ImageButton android:id="@+id/playback_settings_button" style="@style/ExoStyledControls.Button.Bottom.Settings" />
                <ImageButton
                    android:id="@+id/aspect_ratio_button"
                    style="@style/ExoStyledControls.Button.Bottom"
                    android:contentDescription="@string/playback_aspect_ratio"
                    android:src="@drawable/ic_aspect_ratio" />

                <Button
                    android:id="@+id/playback_quality_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/card_focus_border"
                    android:text="@string/playback_quality"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/playback_rate_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/card_focus_border"
                    android:text="@string/playback_rate"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/playback_marker_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/card_focus_border"
                    android:text="@string/playback_next_marker"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/playback_seek_preset_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/card_focus_border"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</merge>
