<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/fullscreen_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <ProgressBar
        android:id="@+id/image_loading_progress"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <View
        android:id="@+id/image_controls_scrim"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/image_viewer_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/image_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/image_viewer_controls_background">

        <TextView
            android:id="@+id/image_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="1000dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/image_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFD5E4EE"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/image_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="320dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/image_viewer_progress_bar"
            android:visibility="gone" />

        <TextView
            android:id="@+id/image_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/screens_polish_image_hint_browse"
            android:textColor="#FFAEBAC4"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
