<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/playback_polish_surface_disabled" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
            <corners android:radius="@dimen/playback_polish_control_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/playback_polish_surface_focused" />
            <stroke
                android:width="@dimen/playback_polish_focus_stroke"
                android:color="@color/playback_polish_accent" />
            <corners android:radius="@dimen/playback_polish_control_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/playback_polish_surface_pressed" />
            <corners android:radius="@dimen/playback_polish_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/playback_polish_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/playback_polish_border_subtle" />
            <corners android:radius="@dimen/playback_polish_control_radius" />
        </shape>
    </item>
</selector>
