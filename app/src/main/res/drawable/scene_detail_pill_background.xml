<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF26333A" />
            <stroke android:width="3dp" android:color="@color/screens_polish_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/screens_polish_control_active" />
            <stroke android:width="1.5dp" android:color="@color/screens_polish_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6242A30" />
            <stroke android:width="1dp" android:color="@color/screens_polish_hairline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
