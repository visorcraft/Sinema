<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#2612171C" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/playback_polish_danger_focused" />
            <stroke
                android:width="2.5dp"
                android:color="@color/playback_polish_danger_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#802A1A1E" />
            <stroke
                android:width="1dp"
                android:color="#4DE55365" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
