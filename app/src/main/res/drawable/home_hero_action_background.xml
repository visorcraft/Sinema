<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_polish_accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_polish_hero_cta_unfocused" />
            <stroke android:width="1dp" android:color="@color/card_polish_accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
