<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/screens_polish_card_focused" />
            <stroke android:width="3dp" android:color="@color/screens_polish_accent" />
            <corners android:radius="@dimen/screens_polish_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF262D34" />
            <stroke android:width="1dp" android:color="@color/screens_polish_hairline" />
            <corners android:radius="@dimen/screens_polish_control_radius" />
        </shape>
    </item>
</selector>
