<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/playback_polish_surface_focused" />
            <stroke
                android:width="2.5dp"
                android:color="@color/playback_polish_accent" />
            <corners android:radius="@dimen/playback_polish_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="@dimen/playback_polish_control_radius" />
        </shape>
    </item>
</selector>
