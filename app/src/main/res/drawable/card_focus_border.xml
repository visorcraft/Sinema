<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#2AABE0" />
            <solid android:color="#FF18242A" />
            <corners android:radius="@dimen/card_polish_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/card_polish_border_unfocused" />
            <solid android:color="@color/card_polish_surface" />
            <corners android:radius="@dimen/card_polish_corner_radius" />
        </shape>
    </item>
</selector>
